# Serve /srv/k3-dashboard (just k3.png) over plain HTTP for the Kindles. The K3 cannot verify
# Caddy's internal CA or speak modern TLS, so this is HTTP on the LAN, limited by the router to the
# Kindles' addresses. It serves a status picture only: no credentials, no write access.
[Unit]
Description=Plain-HTTP server for the K3 status dashboard image
After=network-online.target
Wants=network-online.target

[Service]
User=k3dash
Group=k3dash
ExecStart=/usr/bin/python3 -m http.server 8090 --bind 192.168.10.158 --directory /srv/k3-dashboard
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
